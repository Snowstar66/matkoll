# Copy to .env.local and fill in. Only these names are allowed (AD-14);
# all of them are read and validated in src/server/env.ts. Never commit values.

# Supabase project URL, e.g. the local CLI API URL (Story 1.2).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key. Only for tests and scripts, never used by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated e-mail addresses that may sign in.
ALLOWED_EMAILS=

# AI provider: lmstudio | anthropic | openai | mock (default: mock).
AI_PROVIDER=
# Model id for the chosen provider.
AI_MODEL=
# LM Studio OpenAI-compatible endpoint, e.g. http://localhost:1234/v1
LMSTUDIO_BASE_URL=
# Cloudflare Access service token in front of LM Studio (cloud only).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Cloud AI providers, only when AI_PROVIDER selects them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
