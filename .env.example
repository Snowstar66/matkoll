# Copy to .env.local and fill in. Only these names are allowed (AD-14);
# the app reads and validates them in src/server/env.ts. Never commit values.
# `pnpm db:env` writes the Supabase values from `supabase status`.

# Supabase API URL, locally http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The app's public origin for links in e-mail, e.g. https://matkoll.example.com.
# Required in production; defaults to http://localhost:3000 otherwise. Must be on
# Supabase Auth's redirect allowlist.
SITE_URL=

# Comma-separated e-mail addresses that may sign in. `pnpm users:sync` creates them.
ALLOWED_EMAILS=

# AI provider: lmstudio | anthropic | openai | mock (default: mock).
AI_PROVIDER=
# Model id for the chosen provider.
AI_MODEL=
# LM Studio OpenAI-compatible endpoint, e.g. http://localhost:1234/v1
LMSTUDIO_BASE_URL=
# Cloudflare Access service token in front of LM Studio (cloud only).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Cloud AI providers, only when AI_PROVIDER selects them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- scripts and tests only ---
# Read by scripts/ and tests/, never by the app (AD-4). Keep below this marker.

# Supabase service role (secret) key, for `pnpm users:sync` and the test setup.
SUPABASE_SERVICE_ROLE_KEY=
