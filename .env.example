# Copy to .env.local and fill in. Only these names are allowed (AD-14);
# the app reads and validates them in src/server/env.ts. Never commit values.
# `pnpm db:env` writes the Supabase values from `supabase status`.
# In the cloud (docs/molnet.md) the values go into Vercel > Settings > Environment Variables,
# never into the repo. Each variable below says where it is set: "Vercel Production" and
# "Vercel Preview" are Vercel's environments; "local only" is never set in Vercel.

# Supabase API URL, locally http://127.0.0.1:54321. Cloud: https://<ref>.supabase.co from
# Supabase > Project Settings > Data API. Vercel Production only (never Preview, AD-23).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Cloud: Supabase > Project Settings > API Keys.
# Public by design, protected by row-level security. Vercel Production only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The app's public origin for links in e-mail, e.g. https://matkoll.example.com.
# Required in production; defaults to http://localhost:3000 otherwise. Must be on
# Supabase Auth's redirect allowlist. Cloud: exactly the address people open, one single origin
# (no second alias, no www/apex mix): the AI and photo routes refuse a request whose Origin is another.
# Vercel Production and Preview (Preview may keep the same value).
SITE_URL=

# Comma-separated e-mail addresses that may sign in. `pnpm users:sync` creates them.
# Vercel Production only.
ALLOWED_EMAILS=

# AI provider: lmstudio | anthropic | openai | mock. Defaults to mock outside production;
# required in production (`next build`, `next start`), where mock must be chosen explicitly.
# Cloud: anthropic in Vercel Production, mock in Vercel Preview.
# The app does not start when the settings below do not fit the provider.
AI_PROVIDER=
# Model id. Cloud: claude-haiku-5-5. lmstudio defaults to qwen/qwen3.6-35b-a3b; anthropic and openai require it.
AI_MODEL=
# LM Studio OpenAI-compatible endpoint, e.g. http://localhost:1234/v1. Required for lmstudio.
LMSTUDIO_BASE_URL=
# Cloudflare Access service token in front of LM Studio (cloud only). Both or neither.
# Not needed when the cloud uses Claude; LM Studio on the Mac is optional there.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# How long the mock takes for an AI-förslag call, in milliseconds (0-30000), so the AI queue can be
# tried in tests (Story 12.4). Only the mock reads it. Never set it in Vercel.
AI_MOCK_DELAY_MS=
# Automatic sign-in on your own machine (Story 15.1), local development only. Set both, in
# .env.local, to a local user in ALLOWED_EMAILS, then run `pnpm dev:set-password`. It works only when
# NODE_ENV=development, VERCEL is unset, the host is localhost or 127.0.0.1 and the Supabase URL is
# local. Never set these in Vercel.
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=
# Set by Vercel and by Next. Leave empty; the automatic local sign-in reads them as guards.
VERCEL=
NODE_ENV=
# Set to 1 by `pnpm dev` (loopback only); `pnpm dev:lan` leaves it out, so it never signs in automatically.
MATKOLL_DEV_LOOPBACK=
# Cloud AI providers: required when AI_PROVIDER selects them. ANTHROPIC_API_KEY is secret: mark it
# Sensitive in Vercel Production. OPENAI_API_KEY is not used by the cloud setup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Addresses that see AI in Inställningar outside development; empty = nobody (Story 17.5).
# Cloud: your own address only. Vercel Production only.
AI_SETTINGS_EMAILS=

# The app owner's address (Story 20.3): the sheets under Hjälp > Tyck till say "<Namn> ser texten",
# and `pnpm owner:sync` writes that user's id to the database table app_owner, which decides who sees
# Inkorg in Inställningar (the app never decides that from this variable). Locally: your own address, the same
# as DEV_AUTO_LOGIN_EMAIL. Cloud: your address. Vercel Production only.
OWNER_EMAIL=

# --- scripts and tests only ---
# Read by scripts/ and tests/, never by the app (AD-4). Keep below this marker.

# Supabase service role (secret) key, for `pnpm users:sync`, `pnpm offers:fetch` and the test setup.
# Cloud: typed into your own terminal for `pnpm users:sync` (docs/molnet.md), and a GitHub secret for
# offers.yml (Story 17.11); never in Vercel, never in .env.local for the cloud project.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub Actions, not environment variables (docs/molnet.md) ---
# Set under GitHub > repo > Settings > Secrets and variables > Actions; never in this file.
# Variable CLOUD_ENABLED = true   switches on cloud-migrate.yml, backup.yml and offers.yml (off while unset).
# Secret SUPABASE_ACCESS_TOKEN    Supabase > Account > Access Tokens.
# Secret SUPABASE_DB_PASSWORD     the database password chosen when the project was created.
# Secret SUPABASE_PROJECT_REF     the project id in https://<ref>.supabase.co.
# Secret SUPABASE_DB_URL          Session pooler string with the password (backup).
# Secret BACKUP_PASSPHRASE        at least 32 characters (backup encryption).
# Secret SUPABASE_SERVICE_ROLE_KEY  sb_secret_… (offers.yml: lists the stores, signs in as their owners).
# Secret SUPABASE_PUBLISHABLE_KEY   sb_publishable_…, as in Vercel (offers.yml).
