{
  "name": "matkoll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "eval:ai": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.eval.config.ts",
    "sites:probe": "node --env-file-if-exists=.env.local scripts/probe-recipe-sites.mjs",
    "db:start": "supabase start",
    "db:types": "supabase gen types --local --schema public > src/lib/supabase/database.types.ts",
    "db:env": "node scripts/db-env.mjs",
    "dev:set-password": "node --env-file-if-exists=.env.local scripts/dev-set-password.mjs",
    "users:sync": "node --env-file-if-exists=.env.local scripts/users-sync.mjs",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then lefthook install; fi"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/openai": "4.0.102",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.153",
    "cheerio": "1.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
