  "steps": [
    {
      "title": null,
      "text": "Skär kycklingen i bitar. Hacka lök och vitlök fint och strimla paprikan."
    },
    {
      "title": null,
      "text": "Hetta upp oljan i en stor gryta och bryn kycklingen runt om."
    },
    {
      "title": null,
      "text": "Fräs lök, vitlök och curry i 2 minuter. Rör om så att curryn inte bränns."
    },
    {
      "title": null,
      "text": "Häll i krossade tomater, grädde och vatten och smula ner buljongtärningen. Låt sjuda under lock i 20 minuter."
    },
    {
      "title": null,
      "text": "Lägg i paprikan de sista 5 minuterna. Smaka av med salt och peppar."
    },
    {
      "title": null,
      "text": "Toppa med färsk koriander och servera."
    }
