  "steps": [
    {
      "title": null,
      "text": "Sätt ugnen på 225 grader."
    },
    {
      "title": "Rostad småpotatis",
      "text": "Lägg potatisen på en plåt med bakplåtspapper. Ringla över olivolja och krydda med salt och peppar. Rosta mitt i ugnen i ca 25 minuter."
    },
    {
      "title": "Örtstekt kyckling",
      "text": "Krydda kycklingen med salt och peppar. Stek den i smör med timjankvistarna i ca 5 minuter per sida, tills den är genomstekt."
    },
    {
      "title": "Tryffelsky",
      "text": "Koka upp grädde, buljongtärning och soja. Låt sjuda i 3 minuter och smaka av med tryffelolja."
    },
    {
      "title": "Gräddkokt spetskål",
      "text": "Strimla spetskålen och fräs den i smör. Häll på grädden och låt koka ihop i 3 minuter."
    },
    {
      "title": null,
      "text": "Servera kycklingen med potatisen, spetskålen och skyn."
    }
  ]
