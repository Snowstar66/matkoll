  "steps": [
    {
      "title": null,
      "text": "Sätt ugnen på 225 grader och smörj en ugnsform, ca 25 x 35 cm."
    },
    {
      "title": null,
      "text": "Skär baconet i bitar och stek det knaprigt i en torr stekpanna. Lägg det i formen."
    },
    {
      "title": null,
      "text": "Vispa mjöl och hälften av mjölken till en slät smet. Vispa i resten av mjölken, äggen och saltet."
    },
    {
      "title": null,
      "text": "Häll smeten över baconet och grädda mitt i ugnen i 25–30 minuter, tills pannkakan är gyllenbrun och stelnad."
    },
    {
      "title": null,
      "text": "Låt svalna några minuter, skär i bitar och servera med lingonsylt."
    }
  ]
