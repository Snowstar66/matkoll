{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "git": {
    "deploymentEnabled": {
      "story/**": false,
      "fix/**": false,
      "docs/**": false,
      "base/**": false,
      "batch/**": false,
      "chore/**": false,
      "cloud/**": false,
      "design/**": false,
      "epic/**": false,
      "mockup/**": false,
      "prep/**": false,
      "ux/**": false,
      "wip/**": false,
      "test/**": false,
      "feat/**": false,
      "refactor/**": false,
      "dependabot/**": false,
      "claude/**": false
    }
  },
  "installCommand": "mkdir -p node_modules/.pnpm-store/v11 && (pnpm install --frozen-lockfile || pnpm install --frozen-lockfile)"
}
